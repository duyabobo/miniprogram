.phone-gate {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  align-items: flex-end;
  background: rgba(28, 40, 52, 0.35);
}

.phone-gate__card {
  width: 100%;
  box-sizing: border-box;
  padding: 40rpx 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
}

.phone-gate__title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #1c2834;
}

.phone-gate__input {
  height: 88rpx;
  margin-top: 24rpx;
  padding: 0 24rpx;
  background: #f4f8fb;
  border-radius: 16rpx;
  font-size: 30rpx;
}

.phone-gate__code-row {
  display: flex;
  align-items: center;
}

.phone-gate__code-row .phone-gate__input {
  flex: 1;
}

.phone-gate__send {
  flex-shrink: 0;
  margin: 24rpx 0 0 16rpx;
  padding: 0 8rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: transparent;
  color: #2a9de6;
  font-size: 28rpx;
}

.phone-gate__send::after,
.phone-gate__later::after,
.phone-gate__submit::after {
  border: none;
}

.phone-gate__submit {
  margin-top: 32rpx;
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #45b8f5 0%, #2a9de6 100%);
  border-radius: 48rpx;
}

.phone-gate__later {
  margin-top: 16rpx;
  background: transparent;
  color: #5c6b78;
  font-size: 28rpx;
}
