/* 与首页同一套天空渐变 */
page {
  height: 100%;
  background-color: #5cb8f8;
  background-image: linear-gradient(180deg, #5cb8f8 0%, #a8d9f7 38%, #d4ecfb 68%, #eef8fd 100%);
  background-repeat: no-repeat;
  background-size: 100% 100%;
}

.page-wrap {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 100vh;
  overflow: hidden;
  position: relative;
  background: transparent;
}

.stage {
  flex: 1;
  height: 0;
}

.place-card {
  flex-shrink: 0;
  margin: 12rpx 28rpx 12rpx;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 8rpx 24rpx rgba(46, 152, 220, 0.1);
  overflow: hidden;
}

.place-img {
  display: block;
  width: 100%;
  height: 280rpx;
  background: #d4ecfb;
}

.place-body {
  padding: 22rpx 24rpx 24rpx;
}

.place-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #1c2834;
}

.place-time {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: #5a6d7d;
}

.bottom-bar {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 8rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
}

.share-btn {
  width: 100%;
  height: 88rpx;
  margin: 0;
  padding: 0;
  line-height: 88rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: #1a7fbe;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(46, 152, 220, 0.1);
}

.share-btn::after {
  border: none;
}

.share-btn--pressed {
  opacity: 0.7;
}

.btn-group {
  display: flex;
  flex-direction: row;
  gap: 24rpx;
}

.action-btn {
  flex: 1;
  height: 96rpx;
  margin: 0;
  padding: 0;
  line-height: 96rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  border-radius: 48rpx;
  text-align: center;
  color: #fff;
  background: linear-gradient(135deg, #45b8f5 0%, #2a9de6 100%);
  box-shadow: 0 10rpx 28rpx rgba(42, 157, 230, 0.28);
}

.action-btn::after {
  border: none;
}

.action-btn--pressed {
  transform: scale(0.98);
}

.action-btn--meet,
.action-btn--start-meet,
.action-btn--suitable,
.action-btn--restore {
  color: #fff;
  background: linear-gradient(135deg, #45b8f5 0%, #2a9de6 100%);
  box-shadow: 0 10rpx 28rpx rgba(42, 157, 230, 0.28);
}

.action-btn--cancel,
.action-btn--unsuitable,
.action-btn--end {
  color: #5a6d7d;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 8rpx 24rpx rgba(46, 152, 220, 0.1);
}
