<view class="page-wrap">
  <page-nav title="见面详情" />

  <view class="place-card">
    <image wx:if="{{activity.img && !placeImgHidden}}" class="place-img" src="{{activity.img}}" mode="aspectFill" binderror="onPlaceImgError" />
    <view class="place-body">
      <text class="place-name">{{activity.address}}</text>
      <text class="place-time">{{activity.time}}</text>
    </view>
  </view>

  <scroll-view class="stage" scroll-y="true">
    <profile-board
      wx:if="{{showOpposite}}"
      info-pairs="{{opposite.infoDataPairs}}"
      requirement-pairs="{{opposite.requirementDataPairs}}"
      info-title="ta的信息"
      requirement-title="ta的期望"
      empty-text="还没有可展示的对象资料"
    />
  </scroll-view>

  <view class="bottom-bar" wx:if="{{operate.bottomButtons.length}}">
    <view class="btn-group">
      <button
        wx:for="{{operate.bottomButtons}}"
        wx:key="label"
        class="action-btn action-btn--{{item.styleKey}}"
        hover-class="action-btn--pressed"
        hover-stay-time="80"
        data-btn="{{item}}"
        bindtap="operate"
      >{{item.label}}</button>
    </view>
  </view>
</view>
