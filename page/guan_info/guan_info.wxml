<view class="page-wrap">
  <page-nav title="{{copy.pageTitle}}" />

  <view class="place-card">
    <image wx:if="{{activity.img && !placeImgHidden}}" class="place-img" src="{{activity.img}}" mode="aspectFill" binderror="onPlaceImgError" />
    <view class="place-body">
      <text class="place-name">{{activity.address}}</text>
      <text class="place-time">{{activity.time}}</text>
    </view>
  </view>

  <scroll-view class="stage" scroll-y="true">
    <profile-board
      wx:if="{{showOpposite}}"
      rows="{{opposite.rows}}"
      info-title="{{copy.infoTitle}}"
      requirement-title="{{copy.requirementTitle}}"
      empty-text="{{copy.emptyText}}"
    />
  </scroll-view>

  <view class="bottom-bar" wx:if="{{share.enabled || operate.bottomButtons.length || fee.text || subscribe.label || pendingPay}}">
    <view class="fee-card" wx:if="{{fee.text}}">{{fee.text}}</view>
    <view class="notice-hint" wx:if="{{subscribe.hint && !viewer}}">{{subscribe.hint}}</view>
    <button
      wx:if="{{subscribe.label && !viewer}}"
      class="share-btn"
      hover-class="share-btn--pressed"
      hover-stay-time="80"
      bindtap="enableNotice"
    >{{subscribe.label}}</button>
    <button
      wx:if="{{pendingPay}}"
      class="action-btn action-btn--meet"
      hover-class="action-btn--pressed"
      hover-stay-time="80"
      bindtap="confirmPay"
    >{{pendingPay.buttonLabel}}</button>
    <button
      wx:if="{{share.enabled}}"
      class="share-btn"
      hover-class="share-btn--pressed"
      hover-stay-time="80"
      open-type="share"
    >{{share.label}}</button>
    <view class="btn-group" wx:if="{{operate.bottomButtons.length}}">
      <button
        wx:for="{{operate.bottomButtons}}"
        wx:key="label"
        class="action-btn action-btn--{{item.styleKey}}"
        hover-class="action-btn--pressed"
        hover-stay-time="80"
        data-btn="{{item}}"
        bindtap="operate"
      >{{item.label}}</button>
    </view>
  </view>
</view>
