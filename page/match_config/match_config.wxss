/* 与首页同一套天空渐变 */
page {
  height: 100%;
  background-color: #5cb8f8;
  background-image: linear-gradient(180deg, #5cb8f8 0%, #a8d9f7 38%, #d4ecfb 68%, #eef8fd 100%);
  background-repeat: no-repeat;
  background-size: 100% 100%;
}

.page-wrap {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 100vh;
  overflow: hidden;
  background: transparent;
}

.stage {
  flex: 1;
  height: 0;
}

.transcript {
  margin: 0 28rpx 16rpx;
  padding: 22rpx 24rpx;
  background: rgba(255, 255, 255, 0.72);
  border-radius: 20rpx;
}

.transcript-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #2a96d8;
}

.transcript-body {
  display: block;
  font-size: 28rpx;
  line-height: 1.6;
  color: #1c2834;
}

.voice-dock {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 48rpx calc(20rpx + env(safe-area-inset-bottom));
}

.voice-status {
  min-height: 40rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: #3d5160;
  text-align: center;
}

.mic-btn {
  width: 128rpx;
  height: 128rpx;
  border-radius: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #45b8f5 0%, #2a9de6 100%);
  box-shadow: 0 10rpx 28rpx rgba(42, 157, 230, 0.35);
}

.mic-btn--pressed {
  transform: scale(0.96);
  background: linear-gradient(135deg, #3aa8e8 0%, #2389cf 100%);
}

.mic-btn--recording {
  animation: mic-pulse 1s infinite;
}

.mic-btn--processing {
  opacity: 0.45;
}

.mic-icon {
  width: 52rpx;
  height: 52rpx;
}

.privacy-link {
  margin-top: 20rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #2a96d8;
  text-decoration: underline;
}

.privacy-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(28, 40, 52, 0.35);
}

.privacy-sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 36rpx 40rpx calc(36rpx + env(safe-area-inset-bottom));
  background: #f4fbfe;
  border-radius: 28rpx 28rpx 0 0;
}

.privacy-title {
  display: block;
  margin-bottom: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #1c2834;
}

.privacy-body {
  display: block;
  font-size: 26rpx;
  line-height: 1.7;
  color: #3d5160;
}

.privacy-close {
  margin-top: 28rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #45b8f5 0%, #2a9de6 100%);
}

.privacy-close--pressed {
  background: linear-gradient(135deg, #3aa8e8 0%, #2389cf 100%);
}

@keyframes mic-pulse {
  0% { box-shadow: 0 10rpx 28rpx rgba(42, 157, 230, 0.35); }
  50% { box-shadow: 0 10rpx 36rpx rgba(42, 157, 230, 0.65); }
  100% { box-shadow: 0 10rpx 28rpx rgba(42, 157, 230, 0.35); }
}
