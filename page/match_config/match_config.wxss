/* match_config.wxss - 匹配配置页样式 */

.page-wrap {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f8f8f8;
}

/* 标题区 */
.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #222;
  padding: 40rpx 30rpx 8rpx;
}

.page-subtitle {
  font-size: 24rpx;
  color: #aaa;
  padding: 0 30rpx 20rpx;
}

/* 识别结果 */
.recognized-text {
  margin: 0 20rpx 16rpx;
  padding: 16rpx 20rpx;
  background: #fff8e1;
  border-radius: 12rpx;
  border-left: 4rpx solid #ffc107;
}

.recognized-label {
  font-size: 22rpx;
  color: #888;
}

.recognized-content {
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
}

/* 双侧面板 */
.dual-panel {
  flex: 1;
  display: flex;
  flex-direction: row;
  background: #fff;
  margin: 0 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.panel {
  flex: 1;
  padding: 24rpx 20rpx;
  overflow-y: auto;
}

/* 左右面板内侧 padding 减小，贴近分割线 */
.panel--left {
  padding-right: 16rpx;
}

.panel--right {
  padding-left: 16rpx;
}

.panel-title {
  font-size: 22rpx;
  color: #aaa;
  font-weight: 700;
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
  text-align: center;
}

/* 中间分割线：不设 flex-shrink，让 flex 布局自然居中 */
.divider {
  width: 1rpx;
  flex-shrink: 0;
  background: #e0e0e0;
  margin: 16rpx 0;
  align-self: stretch;
}

/* 配置项 */
.config-item {
  display: flex;
  flex-direction: column;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.config-item:last-child {
  border-bottom: none;
}

.config-label {
  font-size: 20rpx;
  color: #bbb;
  margin-bottom: 4rpx;
}

.config-value {
  font-size: 24rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.4;
}

.empty-tip {
  color: #ccc;
  font-size: 24rpx;
  text-align: center;
  padding: 40rpx 0;
}

/* 底部语音区 */
.bottom-bar {
  padding: 20rpx 40rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.voice-hint {
  font-size: 24rpx;
  color: #aaa;
  text-align: center;
}

.voice-hint--recording {
  color: #f44336;
  font-weight: 600;
}

.voice-hint--processing {
  color: #2196f3;
}

/* 语音按钮 */
.voice-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ff6b35;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 53, 0.4);
  transition: all 0.2s;
}

.voice-btn--recording {
  background: #f44336;
  animation: pulse 1s infinite;
}

.voice-btn--processing {
  background: #9e9e9e;
}

.voice-icon {
  font-size: 52rpx;
}

@keyframes pulse {
  0%   { transform: scale(1);   box-shadow: 0 4rpx 20rpx rgba(244,67,54,0.4); }
  50%  { transform: scale(1.08); box-shadow: 0 4rpx 32rpx rgba(244,67,54,0.7); }
  100% { transform: scale(1);   box-shadow: 0 4rpx 20rpx rgba(244,67,54,0.4); }
}
