<!-- 匹配配置页：我的条件 | 我的期望 双侧展示 + 底部语音输入 -->
<view class="page-wrap">

  <!-- 识别结果文字（有内容时展示） -->
  <view class="recognized-text" wx:if="{{recognizedText}}">
    <text class="recognized-label">识别内容：</text>
    <text class="recognized-content">{{recognizedText}}</text>
  </view>

  <!-- 双侧配置展示区（用普通 view 而非 scroll-view，保证 flex 等分宽度严格居中） -->
  <view class="dual-panel">
    <!-- 左侧：我的条件（border-right 作为分割线） -->
    <view class="panel panel--left">
      <view class="panel-title">我的条件</view>
      <view wx:if="{{myInfoPairs.length}}">
        <view
          wx:for="{{myInfoPairs}}"
          wx:key="desc"
          class="config-item"
        >
          <text class="config-label">{{item.desc}}</text>
          <text class="config-value">{{item.value}}</text>
        </view>
      </view>
      <view wx:else class="empty-tip">暂未配置</view>
    </view>

    <!-- 右侧：我的期望 -->
    <view class="panel panel--right">
      <view class="panel-title">我的期望</view>
      <view wx:if="{{myRequirementPairs.length}}">
        <view
          wx:for="{{myRequirementPairs}}"
          wx:key="desc"
          class="config-item"
        >
          <text class="config-label">{{item.desc}}</text>
          <text class="config-value">{{item.value}}</text>
        </view>
      </view>
      <view wx:else class="empty-tip">暂未配置</view>
    </view>
  </view>

  <!-- 底部语音输入区 -->
  <view class="bottom-bar">
    <view class="voice-hint voice-hint--recording" wx:if="{{recordState === 'recording'}}">
      正在录音…点击停止
    </view>
    <view class="voice-hint voice-hint--processing" wx:elif="{{recordState === 'processing'}}">
      识别中…请稍候
    </view>

    <view
      class="voice-btn voice-btn--{{recordState}}"
      bindtap="onVoiceBtnTap"
    >
      <view wx:if="{{recordState === 'idle'}}" class="voice-icon">🎙️</view>
      <view wx:elif="{{recordState === 'recording'}}" class="voice-icon voice-icon--pulse">⏹️</view>
      <view wx:elif="{{recordState === 'processing'}}" class="voice-icon voice-icon--spin">⏳</view>
    </view>
  </view>
</view>
