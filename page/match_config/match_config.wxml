<view class="page-wrap">
  <page-nav title="{{copy.pageTitle}}" />

  <scroll-view class="stage" scroll-y="true">
    <view class="stage-gap"></view>
    <view class="transcript" wx:if="{{recordState === 'processing'}}">
      <text class="transcript-label">正在解析</text>
      <text class="transcript-body">{{voiceStatusText}}</text>
    </view>

    <view class="transcript" wx:if="{{recognizedText && recordState !== 'processing'}}">
      <text class="transcript-label">{{copy.transcriptLabel}}</text>
      <text class="transcript-body">{{recognizedText}}</text>
    </view>

    <profile-board
      rows="{{rows}}"
      info-title="{{copy.infoTitle}}"
      requirement-title="{{copy.requirementTitle}}"
      empty-text="{{copy.emptyText}}"
    />
  </scroll-view>

  <view class="voice-dock">
    <text class="voice-status">{{voiceStatusText}}</text>
    <view
      class="mic-btn mic-btn--{{recordState}}"
      hover-class="mic-btn--pressed"
      hover-stay-time="80"
      bindtap="onVoiceBtnTap"
    >
      <image wx:if="{{recordState === 'recording'}}" class="mic-icon" src="../../resources/icons/stop.svg" mode="aspectFit" />
      <image wx:else class="mic-icon" src="../../resources/icons/mic.svg" mode="aspectFit" />
    </view>
    <text class="privacy-link" bindtap="openPrivacy">{{copy.privacyEntry}}</text>
  </view>

  <view class="privacy-mask" wx:if="{{showPrivacy}}" bindtap="closePrivacy">
    <view class="privacy-sheet" catchtap="holdSheet">
      <text class="privacy-title">{{copy.privacyTitle}}</text>
      <text class="privacy-body">{{copy.privacyBody}}</text>
      <view class="privacy-close" hover-class="privacy-close--pressed" bindtap="closePrivacy">{{copy.privacyConfirm}}</view>
    </view>
  </view>
</view>
