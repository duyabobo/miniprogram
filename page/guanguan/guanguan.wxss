/* guanguan.wxss - 列表页（天空蓝渐变） */

page {
  height: 100%;
  background-color: #5cb8f8;
  background-image: linear-gradient(180deg, #5cb8f8 0%, #a8d9f7 38%, #d4ecfb 68%, #eef8fd 100%);
  background-repeat: no-repeat;
  background-size: 100% 100%;
}

.page-wrap {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  height: 100%;
  position: relative;
  overflow: hidden;
  background: transparent;
}

.custom-navbar {
  flex-shrink: 0;
  position: relative;
  z-index: 2;
  box-sizing: border-box;
  overflow: hidden;
  background: transparent;
}

.custom-navbar__inner {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.custom-navbar__title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1c2834;
  letter-spacing: 2rpx;
}

.list-container {
  flex: 1;
  overflow: hidden;
  padding-top: 12rpx;
  position: relative;
  z-index: 1;
  background: transparent;
}

.guan-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 0 28rpx 16rpx;
  padding: 22rpx 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 8rpx 24rpx rgba(46, 152, 220, 0.1);
  position: relative;
}

.progress-mark {
  position: absolute;
  top: 14rpx;
  right: 16rpx;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.heart-mark {
  width: 40rpx;
  height: 40rpx;
}

.guan-item--pressed {
  background: rgba(240, 248, 255, 0.98);
}

.date-block {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: linear-gradient(145deg, #d8effc 0%, #e8f6fd 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.date-month {
  font-size: 20rpx;
  line-height: 1.2;
  color: #2a96d8;
}

.date-day {
  font-size: 36rpx;
  line-height: 1.1;
  font-weight: 600;
  color: #1f8fd4;
}

.guan-info {
  flex: 1;
  min-width: 0;
  padding-left: 22rpx;
  padding-right: 36rpx;
}

.guan-address {
  font-size: 30rpx;
  color: #1c2834;
  font-weight: 600;
  line-height: 1.4;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.guan-meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 8rpx;
}

.guan-time {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #5a6d7d;
  line-height: 1.4;
}

.guan-distance {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #2a96d8;
  line-height: 1.4;
}

.bottom-bar {
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: transparent;
  position: relative;
  z-index: 1;
}

.match-config-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 96rpx;
  margin: 0;
  padding: 0;
  background: linear-gradient(135deg, #45b8f5 0%, #2a9de6 100%);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
  line-height: 96rpx;
  box-shadow: 0 10rpx 28rpx rgba(42, 157, 230, 0.35);
}

.match-config-btn::after {
  border: none;
}

.phone-gate {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  align-items: flex-end;
  background: rgba(28, 40, 52, 0.35);
}

.phone-gate__card {
  width: 100%;
  box-sizing: border-box;
  padding: 40rpx 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
}

.phone-gate__title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #1c2834;
}

.phone-gate__hint {
  display: block;
  margin: 16rpx 0 32rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #5c6b78;
}

.phone-gate__later {
  margin-top: 16rpx;
  background: transparent;
  color: #5c6b78;
  font-size: 28rpx;
}

.phone-gate__later::after {
  border: none;
}

.match-config-btn--pressed {
  background: linear-gradient(135deg, #3aa8e8 0%, #2389cf 100%);
  transform: scale(0.98);
  box-shadow: 0 6rpx 18rpx rgba(42, 157, 230, 0.28);
}
