<view class="page-wrap">
  <view class="custom-navbar" style="height: {{navBarHeight}}px; padding-top: {{statusBarHeight}}px;">
    <view class="custom-navbar__inner" style="height: {{navContentHeight}}px;">
      <text class="custom-navbar__title">{{copy.listTitle}}</text>
    </view>
  </view>
  <scroll-view class="list-container" scroll-y="true" enable-flex="true">
    <view
      class="guan-item"
      wx:for="{{guanguanList}}"
      wx:key="id"
      data-guan_id="{{item.id}}"
      data-progress_status="{{item.progressStatus}}"
      data-progress_desc="{{item.progressDesc}}"
      hover-class="guan-item--pressed"
      bindtap="clickGuanInfo"
    >
      <view class="date-block">
        <text class="date-month">{{item.monthLabel}}</text>
        <text class="date-day">{{item.dayLabel}}</text>
      </view>

      <block wx:if="{{copy.showHeart !== false}}">
        <view wx:if="{{item.heartKind === 'single'}}" class="progress-mark">
          <image class="heart-mark" src="../../resources/icons/heart-single.svg" mode="aspectFit" />
        </view>
        <view wx:elif="{{item.heartKind === 'double'}}" class="progress-mark">
          <image class="heart-mark" src="../../resources/icons/heart-double.svg" mode="aspectFit" />
        </view>
        <view wx:elif="{{item.heartKind === 'half'}}" class="progress-mark">
          <image class="heart-mark" src="../../resources/icons/heart-half.svg" mode="aspectFit" />
        </view>
        <view wx:elif="{{item.heartKind === 'solid'}}" class="progress-mark">
          <image class="heart-mark" src="../../resources/icons/heart-solid.svg" mode="aspectFit" />
        </view>
        <view wx:elif="{{item.heartKind === 'broken'}}" class="progress-mark">
          <image class="heart-mark" src="../../resources/icons/heart-broken.svg" mode="aspectFit" />
        </view>
      </block>

      <view class="guan-info">
        <view class="guan-address">{{item.address}}</view>
        <view class="guan-meta">
          <text class="guan-time">{{item.friendlyTime}}</text>
          <text class="guan-distance">{{item.distanceText}}</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <view
    class="login-sheet"
    wx:if="{{loginSheet}}"
    bindtap="cancelLogin"
    catchtouchmove="holdLoginSheet"
  >
    <view class="login-sheet__panel" catchtap="holdLoginSheet">
      <button
        class="login-sheet__action"
        hover-class="login-sheet__action--pressed"
        hover-stay-time="80"
        bindtap="confirmLogin"
      >微信登录</button>
      <view class="login-sheet__gap"></view>
      <button
        class="login-sheet__cancel"
        hover-class="login-sheet__action--pressed"
        hover-stay-time="80"
        bindtap="cancelLogin"
      >取消</button>
    </view>
  </view>

  <view class="bottom-bar" wx:if="{{copy.entryTitle}}">
    <button
      class="match-config-btn"
      hover-class="match-config-btn--pressed"
      hover-stay-time="80"
      bindtap="goToMatchConfig"
    >
      {{copy.entryTitle}}
    </button>
  </view>
</view>
